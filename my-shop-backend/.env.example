NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://myshop:myshop_local@localhost:5433/myshop
# Local Compose password (use URL-safe characters; change outside development).
POSTGRES_PASSWORD=myshop_local
DATABASE_SSL=false
DB_POOL_MAX=20
JWT_SECRET=replace-with-at-least-48-random-characters-before-starting
APP_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-crypto-randomBytes
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
SHIPPING_MINOR=8000
FREE_SHIPPING_THRESHOLD_MINOR=300000
TAX_BASIS_POINTS=0
RETURN_WINDOW_DAYS=14
SMTP_URL=smtp://localhost:1025
MAIL_FROM=MyShop <shop@localhost>
APP_URL=http://localhost:4000
WORKER_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
# Set only when running npm run seed; no default administrator password.
SEED_ADMIN_PASSWORD=
# Online payment remains unavailable until both credentials and public callback are configured.
SSLCOMMERZ_STORE_ID=
STOREFRONT_URL=http://localhost:3000
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_PUBLIC_URL=
